# Copie para .env e ajuste os valores
# cp .env.example .env

NODE_ENV=development
API_PORT=3340
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,https://app.muratorimkt.com.br

# Postgres local (Docker Compose)
POSTGRES_USER=muratori
POSTGRES_PASSWORD=muratori_dev_password
POSTGRES_DB=muratori_dash
POSTGRES_PORT=5433

# Prisma — local (Docker mapeia 5433→5432; na VPS use 5432)
DATABASE_URL=postgresql://muratori:muratori_dev_password@localhost:5433/muratori_dash?schema=public

# Auth (admin)
JWT_SECRET=troque-isto-em-producao-min-32-chars!!
ADMIN_EMAIL=admin@muratori.local
ADMIN_PASSWORD=MuratoriAdmin123!

# Webhook interno opcional (Discord/Slack/n8n)
# INTERNAL_WEBHOOK_URL=https://hooks.example.com/muratori

# Produção na VPS Hostinger (exemplo — NÃO commitar senhas reais)
# DATABASE_URL=postgresql://muratori:SENHA_FORTE@127.0.0.1:5432/muratori_dash?schema=public
